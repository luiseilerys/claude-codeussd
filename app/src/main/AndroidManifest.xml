<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:requestLegacyExternalStorage="true"
        android:label="@string/app_name"
        android:theme="@style/Theme.CodigosCuba">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Fix "package R does not exist": ToolActivity vive en el paquete
             com.herramientas.apk, NO en el namespace de la app
             (cu.codigos.ussd). Con el nombre relativo ".ToolActivity" AGP lo
             resolvía como cu.codigos.ussd.ToolActivity -> error de validacion
             de manifest que abortaba processDebugResources antes de generar
             R.java, provocando los ~43 errores "package R does not exist" en
             todos los fuentes. Se usa el nombre completo de clase. -->
        <activity android:name="com.herramientas.apk.ToolActivity" android:exported="false" />
    </application>
</manifest>
